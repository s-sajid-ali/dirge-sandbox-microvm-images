# Dirge microVM guest image — Python development variant with uv.
#
# Built and published as an OCI artifact for use with:
#   dirge sandbox setup --image ghcr.io/<org>/<repo>/python-dev-arm64:<tag>
#
# See: https://github.com/dirge-code/dirge/blob/main/docs/microvm/CUSTOM_IMAGES.md

FROM docker.io/library/alpine:3.21.3

RUN apk add --no-cache \
        openssh-server \
        ca-certificates \
        curl \
        git \
        build-base \
        vim \
    && mkdir -p /var/empty && chmod 755 /var/empty && chown root:root /var/empty

# Install uv + uvx by copying the static (musl-linked) binaries from
# Astral's Alpine image — the distroless glibc image doesn't run here.
COPY --from=ghcr.io/astral-sh/uv:alpine /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# uv-managed Python installs and tool installs live under /usr/local so they
# are available to the sandbox user regardless of $HOME.
ENV UV_PYTHON_INSTALL_DIR="/usr/local/share/uv/python" \
    UV_TOOL_DIR="/usr/local/share/uv/tools" \
    UV_TOOL_BIN_DIR="/usr/local/bin" \
    UV_CACHE_DIR="/usr/local/share/uv/cache" \
    UV_PYTHON_PREFERENCE="only-managed"

# Pre-install a default Python toolchain so first `uv run`/`uv sync` in the
# guest doesn't need network access.
RUN uv python install 3.13 \
    && mkdir -p /usr/local/share/uv \
    && chmod -R a+rX /usr/local/share/uv

RUN ssh-keygen -A \
    && adduser -D -u 1000 sandbox \
    && echo 'PermitRootLogin no' >> /etc/ssh/sshd_config \
    && echo 'PasswordAuthentication no' >> /etc/ssh/sshd_config \
    && echo 'AcceptEnv LANG LC_*' >> /etc/ssh/sshd_config \
    # dirge injects authorized_keys into /home/sandbox/.ssh via a virtio-fs
    # mount from the host; files arriving over virtio-fs don't carry the
    # ownership sshd's StrictModes check expects, so without this the guest
    # rejects the key with "authentication rejected by the server (publickey)".
    && echo 'StrictModes no' >> /etc/ssh/sshd_config \
    && chmod 700 /home/sandbox \
    && mkdir -p /home/sandbox/.ssh && chmod 700 /home/sandbox/.ssh \
    && mkdir -p /workspace && chown 1000:1000 /workspace

# Alpine's openssh-server is built without PAM, so it never sources
# /etc/environment for sessions — export PATH and uv's env vars from
# /etc/profile instead, which ash (the sandbox user's login shell) reads.
RUN { \
        echo 'export PATH="/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"'; \
        echo 'export UV_PYTHON_INSTALL_DIR="/usr/local/share/uv/python"'; \
        echo 'export UV_TOOL_DIR="/usr/local/share/uv/tools"'; \
        echo 'export UV_TOOL_BIN_DIR="/usr/local/bin"'; \
        echo 'export UV_CACHE_DIR="/usr/local/share/uv/cache"'; \
    } >> /etc/profile

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD pgrep sshd || exit 1

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D", "-e"]
